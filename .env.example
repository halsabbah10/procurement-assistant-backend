# MongoDB — local docker-compose default shown; swap for your Atlas connection
# string (from Atlas UI: Database > Connect > Drivers) for live deployment.
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=procurement

# Get from https://console.anthropic.com/settings/keys (separate from any
# Claude Code login — this is a programmatic API key).
ANTHROPIC_API_KEY=

# Get from https://dashboard.voyageai.com/ — free tier includes 200M tokens.
VOYAGE_API_KEY=

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_CAP=200
